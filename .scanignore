# ============================================================
# CNB 代码安全扫描 · 公共忽略规则
#
# gitignore 风格路径规则，默认对 secrets 与 SCA 两类能力生效。
# 目的：把「确定无攻击面」的路径排除出扫描范围，避免存量噪音
#       淹没真实问题（详见 docs/SECURITY_SCAN.md）。
# ============================================================

# ---------- 第三方代码与依赖产物 ----------
vendor/
**/vendor/
node_modules/
**/node_modules/

# ---------- 构建产物 ----------
dist/
**/dist/
**/*.min.js
**/*.min.css

# ---------- 测试装置 ----------
**/testdata/**
**/*_test.go

# ---------- 示例配置（占位符非真实密钥）----------
config.sample.php
backend/configs/config.example.yaml
**/*.example.yaml
**/*.sample.*

# ---------- 文档与静态站（无运行时代码）----------
docs/
site/
