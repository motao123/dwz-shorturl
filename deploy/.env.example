# dwz-admin deployment environment variables
# Copy this file to .env and fill in real values

# MySQL
MYSQL_ROOT_PASSWORD=root_secret_change_me
DB_PASSWORD=dwz_secret_change_me

# Redis (leave empty for no auth)
REDIS_PASSWORD=

# JWT (must be 32+ random bytes)
JWT_SECRET=please-generate-a-random-32-byte-string-here

# Public short URL base
# 站点对外地址，必填：换成你自己的域，例如 https://links.example.com。
# 留空时短链地址退化为相对路径、续期邮件不附会员中心链接，启动日志会打 warn（#20）。
# 不要再照抄上游示例域名上线——那会把你的用户送到别人的站点上。
PUBLIC_BASE_URL=
