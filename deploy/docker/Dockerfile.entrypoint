# ============================================================
# dwz-shorturl 一键部署入口镜像（installer）
#
# 一个容器里同时具备：
#   - PHP 8 CLI + mysqli  ：跑 PHP 侧基线库表与 config.php 生成
#   - migrate 二进制      ：跑统一迁移入口（Docker 构建阶段编译）
#   - mysql 客户端        ：等待数据库就绪
#
# 只做「一次性初始化」：建库表 → 生成配置 → 设置管理员账号密码。
# 初始化完成后容器退出，真正的长期服务是 backend / frontend / mysql / redis。
# ============================================================
FROM php:8.2-cli-alpine

RUN apk add --no-cache \
        bash \
        mariadb-client \
        tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && docker-php-ext-install mysqli \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# 由 docker-compose 的 build context = 仓库根目录拷贝，保证迁移与 PHP 代码同源。
COPY backend/dist/migrate-docker /usr/local/bin/migrate
COPY backend/migrations/ /app/backend/migrations/
COPY install.sql /app/install.sql
COPY deploy/docker/init.php /app/init.php

RUN chmod +x /usr/local/bin/migrate

# 默认入口：等待 DB → 执行全部迁移 → 生成 config.php → 创建管理员
ENTRYPOINT ["php", "/app/init.php"]
