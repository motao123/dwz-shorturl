# ============================================================
# dwz-shorturl 一键部署的 Web 层镜像
#
# 一个容器同时承担三件事，避免用户再单独配 PHP 站点：
#   1. /admin/   → Vue 管理台静态资源（Docker 构建阶段产出）
#   2. /         → PHP 前台（do.php / api.php / member.php …）
#   3. /<短码>   → 短链跳转（转发给 Go 后端，走统一统计）
#
# 用 nginx + php-fpm（Debian 基础镜像，PHP 8.2 与宝塔环境版本对应）。
# ============================================================
FROM node:24-alpine AS assets
WORKDIR /app
# 连 lockfile 一起拷贝并用 npm ci：保证 axios 等依赖版本与本地/CI 完全一致，
# 否则 npm install 漂移到更新的 1.x 小版本会出现类型/行为不一致。
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund --registry=https://registry.npmmirror.com
COPY frontend/ ./
RUN npm run build

FROM php:8.2-fpm-alpine

RUN apk add --no-cache nginx supervisor tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && docker-php-ext-install mysqli opcache \
    && rm -rf /var/cache/apk/*

WORKDIR /var/www/dwz

# PHP 前台（仓库根目录的 PHP 代码与静态资源）
COPY do.php api.php batch.php member.php index.php stats.php sitemap.php rum.php index.html api.html robots.txt 404.html site.webmanifest privacy.html terms.html report.html /var/www/dwz/
COPY includes/ /var/www/dwz/includes/
COPY assets/ /var/www/dwz/assets/
COPY site/ /var/www/dwz/site/

# webhook 后台投递 worker（#12）。用 supervisord 的 webhook-worker 常驻进程运行；
# 放在这里是因为它只需 PHP + config.php，与前台同镜像最省事。
# 注意：它 require includes/api.inc.php，而该文件模板里 migration 目录按
# ROOT . '/migrations' 定位，故保留原相对路径 /var/www/dwz/migrations/。
COPY migrations/ /var/www/dwz/migrations/

# 违规词库（#11）。PHP 前台与 Go 后台共用同一份 JSON：Go 侧 go:embed 进二进制，
# PHP 侧运行时读取。此前镜像里根本没有 backend/，includes/function.php 只能回落
# 到内置的 3 域名 / 5 关键词，公开 api.php、batch.php 的合规拦截静默弱化到与后台
# 完全不同的强度。刻意落在 web 根之外（/etc/dwz）：黑名单可被公开下载就等于把绕过
# 方法交给提交方。
COPY backend/internal/pkg/data/violation_rules.json /etc/dwz/violation_rules.json

# 管理台构建产物（/admin/ 与 /member/）
COPY --from=assets /app/dist/ /var/www/dwz/admin/
COPY --from=assets /app/dist/member.html /var/www/dwz/member/index.html
COPY --from=assets /app/dist/assets/ /var/www/dwz/member/assets/

RUN mkdir -p /etc/nginx/snippets
COPY deploy/docker/web/nginx.conf /etc/nginx/http.d/default.conf
COPY deploy/docker/snippets/dwz-proxy.conf /etc/nginx/snippets/dwz-proxy.conf
COPY deploy/docker/web/supervisord.conf /etc/supervisord.conf
COPY deploy/docker/web/entrypoint.sh /usr/local/bin/dwz-entrypoint
RUN chmod +x /usr/local/bin/dwz-entrypoint

# 运行期可写目录：限流文件与错误日志。config.php 由 init 容器生成到共享配置目录后
# 由 entrypoint 软链接进来，不进镜像（镜像里绝不能有数据库口令）。
RUN mkdir -p /var/www/dwz/logs/ratelimit /run/nginx \
    && chown -R www-data:www-data /var/www/dwz/logs

EXPOSE 80

# PHP 的 error_log 走 stderr（#59）：/var/www/dwz/logs 不是卷，容器一重建里面的
# php_error.log 就没了，而词库降级、限流器故障、member_secret 缺失这类告警恰恰只在
# 容器部署下最需要被看到。交给 supervisord/docker 日志驱动收集。
ENV DWZ_PHP_ERROR_LOG=/dev/stderr

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/admin/ || exit 1

ENTRYPOINT ["/usr/local/bin/dwz-entrypoint"]
CMD ["supervisord", "-c", "/etc/supervisord.conf"]
