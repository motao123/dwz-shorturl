Options -Indexes

# Block sensitive and operational files before rewrite processing.
<FilesMatch "(?i)^(?:config(?:\.sample)?\.php|setup\.php|install\.sql|nginx\.example\.conf|composer\.(?:json|lock)|.*\.(?:log|sql|bak|old|orig|save|swp))$">
    Require all denied
</FilesMatch>

# Sitemap: serve sitemap.xml via sitemap.php
<IfModule mod_rewrite.c>
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ── Go 后端反代（非 Docker 部署必配）────────────────────────────────
# 管理台 /admin/api、会员中心 /member/api、对外 /public/api 与 /health 都由
# Go 后端提供。纯 PHP 部署（不起 Go）时不需要这些规则，但管理台的「域名池」
# 与会员中心的接口会不可用。
#
# ⚠️ 在 .htaccess 里做反代依赖 mod_proxy，且 Apache 必须允许
#    AllowOverride All（含 Proxy 指令）。共享虚拟主机通常禁用了 mod_proxy，
#    这种情况下请改为在站点根目录建一个 PHP 代理入口，或直接用 nginx。
#    完整说明见 docs/deploy-baota.md。
#
# <IfModule mod_proxy.c>
#     ProxyPreserveHost On
#     RewriteRule ^(admin/api|member/api|public/api|health)(/.*)?$ http://127.0.0.1:8080/$1$2 [P,L,QSA]
# </IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Subdirectory deployment (e.g. project at https://example.com/short/):
    # the relative rewrite target below usually stays in this directory
    # automatically. If your host requires an explicit base path, uncomment
    # the next line and set it to your subdirectory WITH a trailing slash:
    # RewriteBase /short/

    # Block hidden paths, migrations, logs, includes and other internal paths.
    RewriteRule "(^|/)\." - [F,L]
    RewriteRule "^(?:migrations|logs|includes)(?:/|$)" - [F,L,NC]

    # Existing files/directories remain directly addressable unless blocked above.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-5]{6,8})$ do.php?uid=$1 [L,QSA]
</IfModule>
