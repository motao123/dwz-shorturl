# ============================================================
# dwz-shorturl 一键部署配置
#
#   cp .env.example .env
#   # 只需改下面标注「必填」的 3 项，其余保持默认即可
#   docker compose up -d
#   docker compose logs init     # 看初始化结果（会打印管理台地址与账号）
#   浏览器打开 http://<主机IP>/admin/  →  用 ADMIN_USERNAME / ADMIN_PASSWORD 登录
# ============================================================

# ---- 必填 1/3：MySQL root 密码（仅容器内部使用）----
MYSQL_ROOT_PASSWORD=change-me-root

# ---- 必填 2/3：应用数据库密码（单库模式，业务账号）----
DB_PASSWORD=change-me-app

# ---- 必填 3/3：管理员初始密码（至少 8 位）----
ADMIN_PASSWORD=change-me-admin

# ---- 必填 4/4：Redis 密码 ----
REDIS_PASSWORD=change-me-redis

# ---- 以下按需修改 ----

# 数据库名（只有一个库；管理表与公共表都放在这里）
DB_NAME=dwz
DB_USER=dwz

# 管理员账号 / 邮箱
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost

# 对外访问的短链规范地址。部署到域名后建议改成真实地址，
# 例如 https://s.example.com；短链会以该地址为准生成。
PUBLIC_BASE_URL=http://localhost

# 对外暴露的 HTTP 端口（默认 80）。想用别的端口就改这里，如 8088。
HTTP_PORT=80

# 固定密钥：留空则首次初始化随机生成并写入数据卷。
# ⚠️ 建议填写 32 字节以上随机串（例如 openssl rand -hex 32）。
# 留空时容器重建会导致已有登录会话与「密码保护短链」失效。
APP_SECRET_KEY=

# 设为 1 时，每次执行初始化都会把管理员密码重置为 ADMIN_PASSWORD。
# 忘记管理台密码时：改这一行 + 重启 init 容器即可找回。
RESET_ADMIN_PASSWORD=0

# ---- 邮件（SMTP，可选但强烈建议）----
# 不配置的后果：会员「忘记密码」无法发送重置链接（等于死路）；
# 注册验证邮件发不出去，而批量生成要求邮箱已验证（批量功能不可用）。
# 配置示例（QQ 邮箱）：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_USER=noreply@example.com
#   SMTP_PASSWORD=你的SMTP授权码
#   SMTP_FROM=noreply@example.com
#   SMTP_FROM_NAME=短网址
#   SMTP_SSL=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=短网址
SMTP_SSL=true
